        (obs_df["LAT"] >= 30.0) & (obs_df["LAT"] <= 45.0) &
        (obs_df["LON"] >= -100.0) & (obs_df["LON"] <= -80.0)
    )
    obs_filtered = obs_df[spatial_mask].copy()
    if not obs_filtered.empty:
