import torch
import torch.nn as nn
import numpy as np

# Physical Mean and Std per variable [p, t, u, v, q] for scaling
VAR_MEAN = torch.tensor([101325.0, 250.0, 0.0, 0.0, 0.003]).view(1, 5, 1, 1)
VAR_STD  = torch.tensor([15000.0,  35.0, 15.0, 15.0, 0.004]).view(1, 5, 1, 1)

class DAAtmosphericLossNormalized(nn.Module):
    """
    DA-Aware Loss operating on Z-score Normalized Atmospheric Variables.
    Prevents magnitude explosion while preserving B-matrix vertical profile weighting.
    """
    def __init__(self, bmatrix_path=None, device="cpu"):
        super().__init__()
        self.device = device

        # Variable priority weights (In Normalized Space)
        # Higher priority for dynamics (u, v) and moisture (q)
        self.multipliers = {
            "p": 1.0,
            "t": 2.0,
            "u": 5.0,
            "v": 5.0,
            "q": 8.0
        }

        # Level weights initialized to 1.0 (Shape: 1, 32, 1)
        self.level_weights = {
            var: torch.ones((1, 32, 1), device=device) for var in ["p", "t", "u", "v", "q"]
        }

    def forward(self, pred_norm, target_norm):
        """
        pred_norm, target_norm shape: (batch, 5, 32, 2562) [Normalized Space]
        """
        loss_dict = {}
        total_loss = 0.0

        state_vars = ["p", "t", "u", "v", "q"]

        for idx, var in enumerate(state_vars):
            p_var = pred_norm[:, idx, :, :]      # (batch, 32, 2562)
            t_var = target_norm[:, idx, :, :]  # (batch, 32, 2562)

            # Weighted MSE in normalized space
            diff_sq = (p_var - t_var) ** 2
            weighted_mse = torch.mean(diff_sq * self.level_weights[var])

            var_loss = self.multipliers[var] * weighted_mse
            loss_dict[var] = var_loss.item()
            total_loss += var_loss

        return total_loss, loss_dict







