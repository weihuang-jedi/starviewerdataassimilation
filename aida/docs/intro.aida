optimizer.zero_grad()

# Forward pass (model output dict: {'p': ..., 't': ..., 'u': ..., 'v': ..., 'q': ...})
predictions = model(inputs)

# Calculate loss
loss, loss_components = criterion(predictions, targets)

loss.backward()

# Clip gradients to prevent exploding gradients when training vector winds & log(q)
torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)

optimizer.step()

# Print breakdown periodically
print(f"Loss: {loss.item():.4f} | "
      f"P: {loss_components['p']:.4f}, T: {loss_components['t']:.4f}, "
      f"U: {loss_components['u']:.4f}, V: {loss_components['v']:.4f}, "
      f"Q(log): {loss_components['q']:.4f}")

